# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Duke AI Gateway (LiteLLM) ---
# Connect to Duke VPN before use.
LITELLM_BASE_URL=https://REPLACE-WITH-DUKE-GATEWAY-URL
LITELLM_TOKEN=REPLACE_ME

# Model ID from the current Duke AI Dashboard catalog (not an old name).
CTF_MODEL=REPLACE_ME

# --- Benchmark ---
# Path to the cloned CTFTiny (or NYU CTF Bench) checkout and its index.
CTF_BENCHMARK_DIR=./benchmark
CTF_DATASET_JSON=./benchmark/ctftiny.json

# --- Run limits (fixed across all reported attempts) ---
CTF_MAX_STEPS=30
CTF_MAX_MINUTES=15
CTF_MAX_OUTPUT_TOKENS=1024
CTF_TOOL_OUTPUT_CHARS=1500
CTF_TOOL_TIMEOUT_S=60

# --- LangSmith tracing (every model and tool call is traced) ---
# Get a key at https://smith.langchain.com (Settings -> API Keys).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=REPLACE_ME
LANGSMITH_PROJECT=ctf-agent
# EU region only, otherwise leave default:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Output locations (git-ignored) ---
CTF_RUNS_DIR=./runs
