# Copy to .env and fill in. .env is git-ignored; never commit real values.
#
# All three credentials below are generic OpenAI-compatible settings: any server
# that speaks POST {base}/v1/chat/completions with tool calling works.

# --- Option A: Duke AI Gateway (LiteLLM) ---
# Connect to Duke VPN before use.
LITELLM_BASE_URL=https://REPLACE-WITH-DUKE-GATEWAY-URL
LITELLM_TOKEN=REPLACE_ME
# Model ID from the current Duke AI Dashboard catalog (not an old name).
CTF_MODEL=REPLACE_ME

# --- Option B: Ollama Cloud ---
# Key from https://ollama.com (Settings -> API keys). Model catalog is public:
#   curl https://ollama.com/v1/models
# Example tool-capable models: gpt-oss:120b, kimi-k2.7-code, glm-5.3
#LITELLM_BASE_URL=https://ollama.com
#LITELLM_TOKEN=REPLACE_ME
#CTF_MODEL=gpt-oss:120b

# --- Benchmark ---
# Path to the cloned CTFTiny (or NYU CTF Bench) checkout and its index.
CTF_BENCHMARK_DIR=./benchmark
CTF_DATASET_JSON=./benchmark/ctftiny.json

# --- Run limits (fixed across all reported attempts) ---
CTF_MAX_STEPS=30
CTF_MAX_MINUTES=15
CTF_MAX_OUTPUT_TOKENS=1024
CTF_TOOL_OUTPUT_CHARS=1500
CTF_TOOL_TIMEOUT_S=60
# Retries per challenge in the GUI: a MODEL failure (no/wrong flag, budget,
# step-limit or timeout verdict) re-runs on a clean slate up to this many
# EXTRA times (0 = run once). Infrastructure errors stop the retry chain.
#CTF_MAX_RETRIES=0

# --- LangSmith tracing (every model and tool call is traced) ---
# Get a key at https://smith.langchain.com (Settings -> API Keys).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=REPLACE_ME
LANGSMITH_PROJECT=ctf-agent
# EU region only, otherwise leave default:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Output locations (git-ignored) ---
CTF_RUNS_DIR=./runs
